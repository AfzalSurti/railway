generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceType {
  TRAIN
  BUS
  FLIGHT
}

enum BookingStatus {
  DRAFT
  SCHEDULED
  QUEUED
  RUNNING
  AUTHENTICATION_REQUIRED
  PAYMENT_REQUIRED
  UNKNOWN_RESULT
  COMPLETED
  FAILED
  CANCELLED
}

enum ExecutionStatus {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttemptStatus {
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum ActionRequiredType {
  NONE
  LOGIN
  OTP
  CAPTCHA
  PAYMENT
  CONFIRMATION
  MANUAL_REVIEW
}

enum HumanActionType {
  LOGIN
  OTP
  CAPTCHA
  PAYMENT
  CONFIRMATION
  MANUAL_REVIEW
}

enum HumanActionStatus {
  PENDING
  RESOLVED
  EXPIRED
  CANCELLED
}

enum ProviderSessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum PaymentStatus {
  REQUIRED
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  phone            String
  passwordHash     String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  passengers       Passenger[]
  bookingTasks     BookingTask[]
  providerSessions ProviderSession[]
}

model Passenger {
  id                String             @id @default(uuid())
  userId            String
  name              String
  age               Int
  gender            Gender
  phone             String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingPassengers BookingPassenger[]

  @@index([userId])
}

model BookingTask {
  id                     String             @id @default(uuid())
  userId                 String
  serviceType            ServiceType
  provider               String
  source                 String
  destination            String
  journeyDate            DateTime           @db.Date
  scheduledAt            DateTime
  trainNumber            String?
  travelClass            String?
  quota                  String?
  status                 BookingStatus      @default(SCHEDULED)
  queueJobId             String?
  startedAt              DateTime?
  completedAt            DateTime?
  failedAt               DateTime?
  failureCode            String?
  failureReason          String?
  retryCount             Int                @default(0)
  lastAttemptAt          DateTime?
  bookingReference       String?
  cancellationRequested  Boolean            @default(false)
  mockOutcome            String?
  actionRequired         Boolean            @default(false)
  actionRequiredType     ActionRequiredType @default(NONE)
  actionRequiredMessage  String?
  currentStage           String?
  providerStatus         String?
  artifactId             String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  passengers             BookingPassenger[]
  logs                   ExecutionLog[]
  attempts               BookingAttempt[]
  humanActions           HumanActionRequest[]

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

model HumanActionRequest {
  id            String            @id @default(uuid())
  bookingTaskId String
  type          HumanActionType
  status        HumanActionStatus @default(PENDING)
  message       String
  metadata      Json?
  createdAt     DateTime          @default(now())
  resolvedAt    DateTime?
  expiresAt     DateTime
  bookingTask   BookingTask       @relation(fields: [bookingTaskId], references: [id], onDelete: Cascade)

  @@index([bookingTaskId])
  @@index([status])
}

model ProviderSession {
  id        String                @id @default(uuid())
  userId    String
  provider  String
  status    ProviderSessionStatus @default(ACTIVE)
  // Opaque handle to an externally held session. NEVER a raw password, cookie, or OTP.
  reference String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  expiresAt DateTime
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@index([status])
}

model BookingAttempt {
  id             String        @id @default(uuid())
  bookingTaskId  String
  attemptNumber  Int
  status         AttemptStatus
  startedAt      DateTime
  endedAt        DateTime?
  failureCode    String?
  failureReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  bookingTask    BookingTask   @relation(fields: [bookingTaskId], references: [id], onDelete: Cascade)

  @@unique([bookingTaskId, attemptNumber])
  @@index([bookingTaskId])
}

model BookingPassenger {
  bookingTaskId String
  passengerId   String
  bookingTask   BookingTask @relation(fields: [bookingTaskId], references: [id], onDelete: Cascade)
  passenger     Passenger   @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@id([bookingTaskId, passengerId])
}

model ExecutionLog {
  id            String          @id @default(uuid())
  bookingTaskId String
  step          String
  status        ExecutionStatus
  message       String
  metadata      Json?
  createdAt     DateTime        @default(now())
  bookingTask   BookingTask     @relation(fields: [bookingTaskId], references: [id], onDelete: Cascade)

  @@index([bookingTaskId])
}
