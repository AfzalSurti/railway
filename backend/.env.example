DATABASE_URL="postgresql://..."
JWT_SECRET="your-secret"
JWT_EXPIRES_IN="7d"
PORT=5000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"
REDIS_URL="redis://localhost:6379"
MOCK_EXECUTOR_OUTCOME="SUCCESS"
MOCK_EXECUTOR_STEP_DELAY_MS=400
BOOKING_JOB_ATTEMPTS=3
BOOKING_WORKER_CONCURRENCY=1
BOOKING_EXECUTION_TIMEOUT_MS=120000
BROWSER_HEADLESS=false
BROWSER_TIMEOUT_MS=30000
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_ARTIFACT_DIR="./artifacts/browser"
BROWSER_ARTIFACT_RETENTION_DAYS=7
BROWSER_TRACE=true
BROWSER_SAVE_TRACE_ON_SUCCESS=false

# Providers (leave provider base URLs empty until a real, authorized integration exists)
IRCTC_BASE_URL=""
REDBUS_BASE_URL=""
PROVIDER_RECONCILE_ENABLED=true

# Payment abstraction (Phase 5). Only the MOCK payment provider is implemented.
# Never store raw card numbers, CVV, UPI PIN, or OTP anywhere.
PAYMENT_PROVIDER="MOCK"
PAYMENT_CURRENCY="INR"

# Human-in-the-loop (Phase 5)
HUMAN_ACTION_TTL_MS=1800000

# Ticket artifacts (Phase 6). Local filesystem storage; gitignored.
TICKET_STORAGE_DIR="./artifacts/tickets"
TICKET_MAX_BYTES=10485760

# Observability (Phase 6)
METRICS_ENABLED=true
